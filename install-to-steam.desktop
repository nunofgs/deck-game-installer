[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-cd-image;application/x-iso9660-image;application/x-executable;application/x-ms-dos-executable;
Actions=InstallWithSteam

[Desktop Action InstallWithSteam]
Name=Install with Steam
Icon=steam
Exec=sh -c '"$HOME/.local/bin/deck-game-installer" install "$1"' _ %f
